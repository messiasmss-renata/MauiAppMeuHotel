<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuHotel.Views.SobreMeuHotel"
             Title="Sobre">

    <VerticalStackLayout Padding="30"
                         Spacing="20"
                         VerticalOptions="Center"
                         BackgroundColor="Lavender">

        <Label Text="Meu Hotel"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               FontSize="40"
               HorizontalTextAlignment="Center"/>

        <Label Text="Sobre o App Meu Hotel"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="{StaticResource Primary}"
               HorizontalTextAlignment="Center"/>

        <BoxView HeightRequest="2"
                 Color="{StaticResource Primary}"/>

        <Label Text=" O Meu Hotel é um aplicativo desenvolvido na disciplina de Desenvolvimento de Sistemas II, utilizando C#, XAML e .NET MAUI. Principais funcionalidades: cálculo de diárias, seleção de acomodações, quantidade de hóspedes e escolha das datas de check-in e check-out."
               FontSize="17"
               HorizontalTextAlignment="Start"/>

        <BoxView HeightRequest="2"
                 Color="{StaticResource Primary}"/>

        <Label Text="Desenvolvedora: Renata Messias"
               FontSize="14"
               HorizontalTextAlignment="Center"/>

        <Label Text="Projeto acadêmico – 2026."
               FontSize="14"
               HorizontalTextAlignment="Center"/>

        <Button Text="Voltar" 
                Clicked="OnVoltarClicked"/>

    </VerticalStackLayout>

</ContentPage>
