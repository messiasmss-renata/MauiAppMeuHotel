<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuHotel.Views.HospedagemContratadaMeuHotel"
             Title="HospedagemContratadaMeuHotel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Lavender">

    <VerticalStackLayout>

        <Label Text="{Binding QuartoEscolhido.Nome}"
               TextColor="{StaticResource Primary}"
               FontAttributes="Bold"
               FontSize="35"
               HorizontalTextAlignment="Center"/>

        <Border StrokeShape="RoundRectangle 10" Margin="10">
            <VerticalStackLayout Padding="10">

                <HorizontalStackLayout>
                    <Label Text="Adultos: "/>
                    <Label Text="{Binding QtdAdultos}"
                           TextColor="{StaticResource Primary}"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="Crianças: "/>
                    <Label Text="{Binding QtdCriancas}"
                           TextColor="{StaticResource Primary}"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Border StrokeShape="RoundRectangle 10" Margin="10">
            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto">

                <Label Grid.Row="0" Grid.Column="0"
                       Text="Check-in:"/>

                <Label Grid.Row="0" Grid.Column="1"
                       Text="Check-out:"/>

                <Label Grid.Row="0" Grid.Column="2"
                       Text="Estadia"/>

                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding DataCheckin, StringFormat='{0:dd/MM/yyyy}'}"/>

                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding DataCheckout, StringFormat='{0:dd/MM/yyyy}'}"/>

                <Label Grid.Row="1" Grid.Column="2"
                       Text="{Binding Estadias}"/>

            </Grid>
        </Border>

        <Border StrokeShape="RoundRectangle 10" Margin="10">
            <VerticalStackLayout Padding="10">

                <Label Text="Valor Total:"
                       FontAttributes="Bold"/>

                <Label Text="{Binding TotalHospedagem, StringFormat='R$ {0:N2}'}"
                       TextColor="{StaticResource Primary}"
                       FontSize="25"
                       FontAttributes="Bold"/>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>

</ContentPage>
