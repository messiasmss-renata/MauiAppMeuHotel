<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMeuHotel.Views.MeuHotel"
             Title="MeuHotel">

    <ContentPage.Resources>
        <Style TargetType="Label">
               <Setter Property="VerticalTextAlignment" Value="Center"/>
        </Style>
    
    </ContentPage.Resources>
            
        <VerticalStackLayout Padding="10"
                             VerticalOptions="Center"> 
        
        <Label Text="Calculo da Diária" 
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}"
               FontSize="30" 
               Margin="0, 50, 0, 30 "/> 

        <Border StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray300}">
            
            <VerticalStackLayout Padding="10">

                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto">

                    <Label Grid.Row="0" Grid.Column="0" Text="Adultos:"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="0"/>
                    <Stepper Grid.Row="0" Grid.Column="2"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Crianças:" />
                    <Label Grid.Row="1" Grid.Column="1" Text="0" />
                    <Stepper Grid.Row="1" Grid.Column="2" />
                </Grid>
                
                <Label Text="Selecione sua acomodação: " 
                       HorizontalTextAlignment="Center" 
                       Margin="0, 20, 0, 5 "/>

                <Picker/>


                <Border StrokeShape="RoundRectangle 10"
                        BackgroundColor="{StaticResource Gray100}"
                        Margin="10">

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *"
                          RowSpacing="10"
                          Padding="10"> 
                        
                        <Label Grid.Row="0" Grid.Column="0" Text="Data check-in:" />
                        <DatePicker  Grid.Row="0" Grid.Column="1"/>



                        <Label Grid.Row="1" Grid.Column="0" Text="Data check-out:" />
                        <DatePicker  Grid.Row="1" Grid.Column="1"/>
                        
                    </Grid>

                </Border>

                <Button Text="Calcular" />


            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
        
</ContentPage>